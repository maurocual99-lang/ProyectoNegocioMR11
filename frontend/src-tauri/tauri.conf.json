{
  "$schema": "https://schema.tauri.app/config/2",

  "productName": "MR11",

  "version": "0.2.4",

  "identifier": "com.mr11.proyectonegocio",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mini Mercado Ruta 11",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,

    "targets": [
      "nsis"
    ],

    "createUpdaterArtifacts": true,

    "externalBin": [
      "binaries/mr11-backend"
    ],

    "resources": [
      "resources/postgresql-installer.exe",
      "resources/configurar-postgres.ps1"
    ],

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Spanish"
        ],
        "headerImage": "./installer-assets/header.bmp",
        "sidebarImage": "./installer-assets/sidebar.bmp",
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico",
        "startMenuFolder": "MR11",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },

  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBMEFDRUNDNzNBRkVEMzUKUldRMTdhOXp6TTRLdWtOSU95ZzVqcWJXU1Y2MGcrUVdtL0lpUG1lMG5SakxETDRjbjVyUklidDcK",

      "endpoints": [
        "https://github.com/maurocual99-lang/ProyectoNegocioMR11/releases/latest/download/latest.json"
      ],

      "windows": {
        "installMode": "passive"
      }
    }
  }
}
